# Copy this file to .env and fill in the keys.

OPENAI_API_KEY=
FIRECRAWL_API_KEY=

# Optional: a brand folder on this machine to read on first start, relative to this file.
# Brands can also be added in the app with "Add brand".
#   BRAND_DIR=./path/to/brand-folder
BRAND_DIR=
# Optional: the name shown for that brand.
BRAND_NAME=
# Optional: comma-separated folders or files inside BRAND_DIR that are not brand material.
#   BRAND_EXCLUDE=briefs
BRAND_EXCLUDE=

# Models by size. Every AI job asks for a size; change the model here.
#   small:  document cards, metadata, image descriptions, memory extraction
#   medium: brand fact extraction, content edits, claims checking
#   large:  chat, campaign planning, final content
# Prices live in backend/app/ai/pricing.py; a model with no price there shows "price unknown".
MODEL_SMALL=gpt-6-luna
MODEL_MEDIUM=gpt-6.1-terra
MODEL_LARGE=gpt-6.1-sol
MODEL_EMBEDDING=text-embedding-3-small
